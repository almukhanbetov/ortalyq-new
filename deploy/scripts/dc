#!/usr/bin/env bash
# docker compose for the production stack, with IMAGE_TAG taken from the current release (current_tag).
# Usage: scripts/dc ps | logs -f api | exec postgres psql -U bilimway ...
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -z "${IMAGE_TAG:-}" ]]; then
  IMAGE_TAG="$(cat "$ROOT/current_tag" 2>/dev/null || true)"
fi
if [[ -z "$IMAGE_TAG" ]]; then
  echo "dc: no release yet (no $ROOT/current_tag) — run scripts/deploy.sh <commit-sha> or set IMAGE_TAG" >&2
  exit 1
fi
export IMAGE_TAG
exec docker compose --project-directory "$ROOT" -f "$ROOT/compose.yml" --env-file "$ROOT/.env" "$@"
