# /opt/bilimway/.env — production settings of bilimway.kz. Example only: no real secrets here.
# Create on the server:  cp .env.production.example .env && chmod 600 .env  — then fill in the values.
# The file stays on the VPS only. It is never committed and never stored in GitHub.

# --- Site ---------------------------------------------------------------------------------------
# Must equal the NEXT_PUBLIC_API_URL the web image was built with (GitHub variable SITE_URL).
SITE_URL=https://bilimway.kz
SITE_DOMAIN=bilimway.kz
WWW_DOMAIN=www.bilimway.kz
# Contact address for Let's Encrypt (certificate expiry notices).
ACME_EMAIL=admin@example.com

# --- Database -----------------------------------------------------------------------------------
# Generate: openssl rand -hex 32   (hex only: the value is put into a connection URL unescaped)
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32

# --- Sessions and login limits ------------------------------------------------------------------
SESSION_TTL_HOURS=336
LOGIN_MAX_PER_EMAIL=5
LOGIN_MAX_PER_IP=30
LOGIN_WINDOW_MINUTES=15

# --- Uploads ------------------------------------------------------------------------------------
UPLOAD_MAX_MB=10

# --- Optional integrations ----------------------------------------------------------------------
# GIF search in chat. Empty = the chat shows "not configured".
GIPHY_API_KEY=

# Mail: keep "log" until real mail is set up (SMTP, TLS, SPF/DKIM — separate tasks).
MAIL_DRIVER=log
MAIL_SMTP_ADDR=
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM=

# --- Only for local checks of this compose file; leave commented on the VPS ---------------------
# IMAGE_REGISTRY=ghcr.io/almukhanbetov/ortalyq-new
# HTTP_PORT=80
# HTTPS_PORT=443
