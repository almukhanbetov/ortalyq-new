# Local development defaults. Never reuse these values in production.
APP_ENV=local
HTTP_ADDR=:8448
DATABASE_URL=postgres://ortalyq_new:ortalyq_new_local@localhost:5448/ortalyq_new?sslmode=disable
CORS_ORIGINS=http://localhost:3448
# Reverse proxy CIDRs whose X-Forwarded-For is trusted (production: Caddy's Docker networks). Empty = Gin default.
TRUSTED_PROXIES=
SESSION_COOKIE_NAME=ortalyq_session
# Local runs over http; production requires COOKIE_SECURE=true (enforced on startup).
COOKIE_SECURE=false
SESSION_TTL_HOURS=336
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=10
AUTO_MIGRATE=false
LOGIN_MAX_PER_EMAIL=5
LOGIN_MAX_PER_IP=30
LOGIN_WINDOW_MINUTES=15
# Optional: GIF search in chat. Leave empty to show the "not configured" state.
GIPHY_API_KEY=
GIPHY_API_BASE=https://api.giphy.com
# Demo account passwords for `api seed` (APP_ENV=local only).
SEED_ADMIN_PASSWORD=admin-local-123
SEED_TEACHER_PASSWORD=teacher-local-123
SEED_STUDENT_PASSWORD=student-local-123
# Mail (marathon invitations). log = nothing is sent, letters stay in email_outbox and the log (metadata only).
# smtp is for a local test receiver (go run ./cmd/mailsink); a real mail server is a separate, explicit step.
MAIL_DRIVER=log
MAIL_SMTP_ADDR=
MAIL_FROM=
APP_URL=http://localhost:3448
